# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Go ----
/dist/
/deploytool
/deploytool.exe
*.test
*.out
*.prof

# ---- Rust ----
/target/
# cargo-outdated / cargo-machete 之类工具的临时输出
*.rs.bk

# ---- 打包产物 ----
build/
*.apk
*.aab

# ---- 本地机密配置（含服务器明文口令，严禁提交）----
# 与 legacy-python/.gitignore 的同名规则保持一致：
# config.yaml 只在本机存在，仓库里只放无口令的 config.template.yaml。
config.yaml
config.local.yaml
*.secret.yaml
.env
.env.*
secrets/

# ---- 崩溃日志 ----
crash.log

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
